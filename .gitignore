# ==============================================================================
# .gitignore — Sistema de Gestión Académica (SGA) UCV
# Configurado para clonar y ejecutar limpiamente en cualquier equipo
# ==============================================================================

# 1. Dependencias y entornos (se instalan con npm install)
node_modules/
**/node_modules/
.vercel/
.next/
**/.next/

# 2. Caché de Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/

# 3. Paquetes ZIP de despliegue (se regeneran con: python build_deploy_packages.py)
*.zip

# 4. Sesiones activas de WhatsApp y multimedia temporal
data/whatsapp_session/
data/whatsapp_media/
data/whatsapp_chats.json
.wwebjs_auth/
.wwebjs_cache/

# 5. Bases de datos SQLite locales (server.py las inicializa automáticamente)
*.db
*.sqlite
*.sqlite3
data/*.db
formulario_delegados/data/*.db

# 6. Archivos temporales de operación (se autogeneran desde los *_base.json)
data/pau_correos.json
data/grupos.json
data/docentes.json
data/carpetas.json
data/directorios.json
data/supervisiones.json
formulario_docentes/data/firmas/*
!formulario_docentes/data/firmas/.gitkeep

# 7. Archivos Excel de prueba, PDFs pesados y carpetas auxiliares antiguas
*.xlsx
*.xls
~$*
excels/
excels_summary.json
pdfs/
Notas/
notas/

# 8. Logs y archivos de depuración
*.log
debug.log
error_log
npm-debug.log*

# 9. Sistema Operativo y Editores
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
