{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/reset",
      "dest": "/api/grupos.js"
    },
    {
      "src": "/api/grupos",
      "dest": "/api/grupos.js"
    },
    {
      "src": "/api/pau",
      "dest": "/api/pau.js"
    },
    {
      "src": "/api/login",
      "dest": "/api/login.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
