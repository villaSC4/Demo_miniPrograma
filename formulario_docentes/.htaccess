# ========================================================================
# .htaccess — Control de Asistencia Docente 2026-2 (UCV)
# Optimizado para Apache en cPanel
# ========================================================================

AddDefaultCharset UTF-8
DefaultLanguage es

# Página de inicio predeterminada
DirectoryIndex index.html index.php

# Deshabilitar listado de directorios
Options -Indexes
ServerSignature Off

# Proteger archivos de configuración, base de datos y documentación
<FilesMatch "(\.sql|\.db|\.json|config\.php|\.md|\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear acceso HTTP directo a la carpeta data
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/ - [F,L]
</IfModule>
